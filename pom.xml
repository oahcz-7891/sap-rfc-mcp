<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.3</version>
    <relativePath/>
  </parent>

  <groupId>saprfcmcp</groupId>
  <artifactId>sap-rfc-mcp</artifactId>
  <version>1.0.0</version>
  <name>sap-rfc-mcp</name>
  <description>单文件 SAP RFC MCP 服务（Spring Boot + SSE + JCo）</description>

  <properties>
    <java.version>1.8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- SAP JCo：已 install 到本地仓库（com.sap:sapjco3:3.0.6），普通依赖即可 -->
    <dependency>
      <groupId>com.sap</groupId>
      <artifactId>sapjco3</artifactId>
      <version>3.0.6</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 把依赖打进可执行 jar -->
          <includeSystemScope>true</includeSystemScope>
          <!-- mvn spring-boot:run 时自动加载 sapjco3.dll（相对项目根，避免路径含空格被拆参数） -->
          <jvmArguments>-Djava.library.path=lib</jvmArguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
